# LALA — Provider Configuration
# Compatible with any OpenAI-compatible API endpoint.

# --- API Key (required for cloud providers, optional for local) ---
OPENAI_API_KEY=sk-proj-...

# --- Provider Base URL ---
# OpenAI (default):   https://api.openai.com/v1
# OpenRouter:         https://openrouter.ai/api/v1
# Groq:               https://api.groq.com/openai/v1
# LM Studio (local):  http://localhost:1234/v1
# Ollama (local):     http://localhost:11434/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Vision / Multimodal Model ---
# OpenAI:     gpt-4o
# OpenRouter: openai/gpt-4o  |  google/gemini-pro-vision  |  anthropic/claude-3.5-sonnet
# Groq:       llama-3.3-70b-versatile
# LM Studio:  local-model
# Ollama:     llava
VISION_MODEL=gpt-4o
