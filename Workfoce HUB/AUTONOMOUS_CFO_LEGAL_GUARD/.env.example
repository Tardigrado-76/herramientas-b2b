# Entidad y Empresa
TENANT_ID=pyme-es-001
COMPANY_NAME=Empresa Ejemplo S.L.
COMPANY_CIF=B12345678

# Modo de Inferencia (BYOK)
# Opciones: "cloud" (OpenAI/Claude/Gemini/DeepSeek) o "local" (Ollama/vLLM)
INFERENCE_MODE=local

# 1. Modo Local On-Premise / Air-Gapped (Cero Fuga de Datos)
OLLAMA_API_BASE=http://localhost:11434/v1
LOCAL_MODEL_NAME=llama3.3:latest
AIR_GAPPED_MODE=true

# 2. Modo Cloud BYOK (Claves Propietarias del Cliente)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
DEFAULT_CLOUD_MODEL=gpt-4o-mini
FALLBACK_CLOUD_MODEL=deepseek-chat

# Conectores SDP (ERP & Bancos)
HOLDED_API_KEY=
A3_INNUVA_CLIENT_ID=
A3_INNUVA_CLIENT_SECRET=
SAGE50_REFRESH_TOKEN=
PSD2_CERTIFICATE_PATH=

# Facturación Electrónica & Cumplimiento
ELECTRONIC_INVOICE_MODE=crea_y_crece   # crea_y_crece | verifactu | ticketbai
VERIFACTU_PRODUCTION=false
TICKETBAI_PROVINCE=bizkaia             # bizkaia | gipuzkoa | alava

# Búnker Criptográfico & Auditoría NIS2
BUNKER_LEDGER_PATH=data/audit_ledger/audit_nis2_ledger.jsonl
BUNKER_HMAC_SECRET=bunker_master_secret_key_change_in_production
