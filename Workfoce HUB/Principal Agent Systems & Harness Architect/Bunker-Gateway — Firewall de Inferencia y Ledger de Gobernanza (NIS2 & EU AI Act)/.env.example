# Bunker-Gateway Environment Configuration
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=INFO

# Upstream LLM Endpoints
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_API_KEY=

# Local LLM Fallback (Air-Gapped)
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1

# Security & Guardrails
ENFORCE_PII_REDACTION=true
ENFORCE_INJECTION_SHIELD=true
ENFORCE_SECRET_DETECTION=true
ENFORCE_CIRCUIT_BREAKER=true
ENFORCE_ABAC=true

# Ledger & Compliance
LEDGER_FILE_PATH=data/audit_nis2_ledger.jsonl
PQC_SEAL_INTERVAL_MINUTES=60
COMPANY_NAME="Enterprise Autonomous Systems"
