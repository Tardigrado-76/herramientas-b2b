# Autonoma SWE-Fleet - Micro-SaaS Containerfile
# Hardened minimal Python 3.11 environment with Git CLI for isolated worktrees

FROM python:3.11-slim

LABEL maintainer="Quantigrade Autonomous Systems"
LABEL description="Autonoma SWE-Fleet - Engineering Swarm Control Plane"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONUTF8=1 \
    PYTHONIOENCODING=utf-8 \
    STREAMLIT_SERVER_PORT=8512 \
    STREAMLIT_SERVER_HEADLESS=true \
    STREAMLIT_SERVER_ADDRESS=0.0.0.0

WORKDIR /app

# Install security certificates & Git
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application source code
COPY . .

# Set up git identity
RUN git config --global user.name "FleetBot" && \
    git config --global user.email "fleetbot@quantigrade.internal"

# Create non-root user for security (NIS2 Compliance)
RUN useradd -m -u 1001 appuser && \
    mkdir -p /app/storage /app/sandbox/isolated_worktrees && \
    chown -R appuser:appuser /app

USER appuser

EXPOSE 8512

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8512/_stcore/health || exit 1

CMD ["streamlit", "run", "app_streamlit.py"]
