# Autonoma SWE-Fleet Configuration
PORT=8512
AIR_GAPPED_MODE=true
PYTHONUTF8=1
PYTHONIOENCODING=utf-8

# Local Ingestion & Inference
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5-coder:latest

# BYOK Cloud Inference (Optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# The Witness Watchdog Safeguards
WITNESS_MAX_TOKENS_PER_BEAD=40000
WITNESS_MAX_CONSECUTIVE_TEST_FAILS=3
WITNESS_INACTIVITY_TIMEOUT_SECONDS=180

# Git Worktrees Sandbox Path
WORKTREES_BASE_DIR=sandbox/isolated_worktrees
TARGET_REPO_PATH=sandbox/sample_repo
